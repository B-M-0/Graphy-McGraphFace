<Window x:Class="Interface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interface"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1600">



    <Grid ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="74.404"/>
            <RowDefinition/>

            <RowDefinition Height="74.404"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>


        <Rectangle Name="TitleBackDrop" Grid.Column="1" Grid.ColumnSpan="7" Grid.Row="2" Grid.RowSpan="5" Visibility="Collapsed" Margin="5,2" Fill="WhiteSmoke" />

        <Image Name="Title" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="7" Grid.RowSpan="3" Visibility="Collapsed" Margin="50,2" />






        <Rectangle Name="SideBar"  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="21" VerticalAlignment="Stretch" Fill="#99000000" Visibility="Collapsed" />

        <Rectangle Name="Input0RenderBackDrop" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed" Margin="5,2" Fill="WhiteSmoke" />
        <Rectangle Name="Input1RenderBackDrop" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="5" Grid.RowSpan="2" Visibility="Collapsed" Margin="5,2" Fill="WhiteSmoke"/>
        <Rectangle Name="Input2RenderBackDrop" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="8" Grid.RowSpan="2" Visibility="Collapsed" Margin="5,2" Fill="WhiteSmoke"/>


        <WpfPlot Name="Graph" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="6" Grid.RowSpan="10" BorderThickness="14" />


        <TextBox Name ="Function_Input0" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row ="4" FontSize="24" FontStyle="Italic" Visibility ="Collapsed" Margin="5,2" TextChanged="TextBox0_TextChanged"/>
        <TextBox Name ="Function_Input1" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row ="7" FontSize="24" FontStyle="Italic" Visibility ="Collapsed" Margin="5,2" TextChanged="TextBox1_TextChanged"/>
        <TextBox Name ="Function_Input2" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row ="10" FontSize="24" FontStyle="Italic" Visibility ="Collapsed" Margin="5,2" TextChanged="TextBox2_TextChanged"/>


        <Image Name="Input0Render" Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed" Margin="5,2" />
        <Image Name="Input1Render" Grid.Column="2" Grid.Row="5" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed" Margin="5,2" />
        <Image Name="Input2Render" Grid.Column="2" Grid.Row="8" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed" Margin="5,2" />

        <Button Name="OpenSideBar" Grid.Column="0" Grid.Row="5"  Grid.RowSpan="3" VerticalAlignment="Stretch" Style ="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"  FontSize="16" Background="White" Click="Button_Click">&gt;</Button>

        <TextBox Name ="Transformation_Input0" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row ="4" FontSize="24" FontStyle="Italic" Visibility ="Collapsed" Margin="5,2" TextChanged="TextBox0_TextChanged"/>
        <TextBox Name ="Transformation_Input1" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row ="7" FontSize="24" FontStyle="Italic" Visibility ="Collapsed" Margin="5,2" TextChanged="TextBox1_TextChanged"/>
        <TextBox Name ="Transformation_Input2" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row ="10" FontSize="24" FontStyle="Italic" Visibility ="Collapsed" Margin="5,2" TextChanged="TextBox2_TextChanged"/>



        <TextBox Name="Calculation_Input0" Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="3" FontSize="24" FontStyle="Italic" Visibility ="Collapsed" Margin="5,2" TextChanged="Calculation0_TextChanged"/>
        <Rectangle Name="Calculation_InputBackDrop0" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="3" Visibility ="Collapsed" Margin="5,2" Fill="WhiteSmoke"/>
        <Rectangle Name="Calculation_OutputBackDrop0" Grid.Column="5" Grid.Row="3" Grid.ColumnSpan="3" Visibility ="Collapsed" Margin="5,2" Fill="WhiteSmoke"/>

        <Image Name="Calculation_InputRender0" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="3" Visibility ="Collapsed"/>
        <Image Name="Calculation_OutputRender0" Grid.Column="5" Grid.Row="3" Grid.ColumnSpan="3" Visibility ="Collapsed"/>



        <TextBox Name ="Complex_Input0" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row ="4" FontSize="24" FontStyle="Italic" Visibility ="Collapsed" Margin="5,2" TextChanged="TextBox0_TextChanged"/>
        <TextBox Name ="Complex_Input1" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row ="7" FontSize="24" FontStyle="Italic" Visibility ="Collapsed" Margin="5,2" TextChanged="TextBox1_TextChanged"/>
        <TextBox Name ="Complex_Input2" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row ="10" FontSize="24" FontStyle="Italic" Visibility ="Collapsed" Margin="5,2" TextChanged="TextBox2_TextChanged"/>


        <Label Name="AngleMeasurementLabel"  Content="Angle Measurement:" Grid.Column="2" Grid.Row="3" FontSize="22" Margin="0,0,0,20" Visibility="Collapsed"/>
        <ComboBox  Name="AngleMeasurement" Text="Radians" SelectionChanged="AngleMeasurement_SelectionChanged" Grid.Column="2" Grid.Row="3" Visibility="Collapsed" FontSize="18" Margin="0,30,0,0" Height="30" >
            <ComboBoxItem Content="Radians"/>
            <ComboBoxItem Content="Degrees"/>
            <ComboBoxItem Content="Gradians"/>
        </ComboBox>

        <Label Name="ThemeLabel"  Content="Theme:" Grid.Column="2" Grid.Row="4" FontSize="22" Margin="0,0,0,20" Visibility="Collapsed"/>
        <ComboBox  Name="Theme" SelectionChanged="Theme_SelectionChanged" Grid.Column="2" Grid.Row="4" Visibility="Collapsed" FontSize="18" Margin="0,30,0,0" Height="30" >
            <ComboBoxItem Content="Black"/>
            <ComboBoxItem Content="Blue1"/>
            <ComboBoxItem Content="Blue2"/>
            <ComboBoxItem Content="Blue3"/>
            <ComboBoxItem Content="Burgundy"/>
            <ComboBoxItem Content="Control"/>
            <ComboBoxItem Content="Default"/>
            <ComboBoxItem Content="Earth"/>
            <ComboBoxItem Content="Grey1"/>
            <ComboBoxItem Content="Grey2"/>
            <ComboBoxItem Content="Hazel"/>
            <ComboBoxItem Content="Light1"/>
            <ComboBoxItem Content="Light2"/>
            <ComboBoxItem Content="Monospace"/>
            <ComboBoxItem Content="Pink"/>
            <ComboBoxItem Content="SeaBorn"/>
        </ComboBox>


        <Button Name="ResetGraph" Content="Reset Graph" Visibility="Collapsed" Grid.Column="3" Grid.Row="0"  Grid.RowSpan="2" Grid.ColumnSpan="1" VerticalAlignment="Stretch" Margin="5,10" FontSize="16" Background="White"  Click="ResetGraph_Clicked"></Button>
        <Button Name="ReturnFromSettings" Content="Return" Visibility="Collapsed" Grid.Column="3" Grid.Row="0"  Grid.RowSpan="2" Grid.ColumnSpan="1" VerticalAlignment="Stretch" Margin="5,10" FontSize="16" Background="White"  Click="ExitSettings"></Button>

        <Button Name="GoToMainMenu" Content="Main Menu" Visibility="Collapsed" Grid.Column="2" Grid.Row="0"  Grid.RowSpan="2" Grid.ColumnSpan="1" VerticalAlignment="Stretch" Margin="5,10" FontSize="16" Background="White"  Click="OpenMainMenu"></Button>


        <Button Name="GoToFunctions" Content="Real Functions" Visibility="Collapsed" Grid.Column="2" Grid.Row="5"  Grid.RowSpan="1" Grid.ColumnSpan="1" VerticalAlignment="Stretch" Margin="5,10" FontSize="16" Background="White"  Click="OpenFunctions"></Button>
        <Button Name="GoToTransformations" Content="Transformations" Visibility="Collapsed" Grid.Column="3" Grid.Row="5"  Grid.RowSpan="1" Grid.ColumnSpan="1" VerticalAlignment="Stretch" Margin="5,10" FontSize="16" Background="White"  Click="OpenTransformations"></Button>
        
        <Button Name="GoToCalculations" Content="Calculate" Visibility="Collapsed" Grid.Column="4" Grid.Row="5"  Grid.RowSpan="1" Grid.ColumnSpan="1" VerticalAlignment="Stretch" Margin="5,10" FontSize="16" Background="White"  Click="OpenCalculations"></Button>
        <Button Name="ToggleModuloButton" Content="Show Alternate Form" Grid.Column="5" Grid.Row="4" Margin="5,20" Click="ToggleModulo" Visibility="Hidden"></Button>

        <Button Name="GoToComplexPlane" Content="Argand Diagram" Visibility="Collapsed" Grid.Column="5" Grid.Row="5"  Grid.RowSpan="1" Grid.ColumnSpan="1" VerticalAlignment="Stretch" Margin="5,10" FontSize="16" Background="White"  Click="OpenComplexNumbers"></Button>


        <Button Name="GoToSettings" Visibility="Visible" Grid.Column="1" Grid.Row="1" Width="50" Height="50"  Click="OpenSettings" Background="AliceBlue">
            <StackPanel>
                <Image Visibility="Visible" Source="cog.jpg"/>
            </StackPanel>
        </Button>
        

    </Grid>
</Window>
